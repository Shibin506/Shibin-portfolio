+            print(f"   {i}. {t}\n")
+        print(f"  figures -> {rel(figdir)}/ ({len(figs)} PNGs)")
+        print(f"  report  -> {rel(report_dir / 'EDA_REPORT.md')}")
+        print(f"  report  -> {rel(report_dir / 'eda_report.html')}   (open this in the demo)")
+        print(f"  numbers -> {rel(report_dir / 'eda_summary.json')}")
