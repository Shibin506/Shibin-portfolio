+            left += share
+    ax.set_yticks(range(len(labels)), labels, fontsize=8)
+    ax.invert_yaxis()
+    ax.set_xlabel("share of occurrences in human references")
+    ax.set_title("Spelling variants actually used for the most frequent lexicon words")
