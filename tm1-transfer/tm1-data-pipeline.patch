+                                        tag_tokens(r["hinglish"], r["english"]))
+        human = [r for r in rows if r["ref_source"] == "human"]
+        write_conll(conll_out, human)
+        print(f"  language-tagged human refs -> {rel(conll_out)}  (input for 298-22 --cmi-only)")
+
+        # lengths
+        uniq = OrderedDict()
